# Copy to .env.docker (ignored by Git and the image). Never use demonstration values.
SECRET_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
RAG_RETRIEVAL_METHOD=vector
RAG_RERANK_ENABLED=false
DEEPSEEK_RAG_TIMEOUT=60
DEEPSEEK_QUESTION_TIMEOUT=60
DEEPSEEK_TOPIC_TIMEOUT=60
DEEPSEEK_FEEDBACK_TIMEOUT=15
DEEPSEEK_COACH_TIMEOUT=20
DASHSCOPE_EMBEDDING_TIMEOUT=30
