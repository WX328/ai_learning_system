# Required for login tokens; use a long, random value.
SECRET_KEY=
# Optional local data directory; create it before migrating. Default: project root.
# APP_DATA_DIR=D:/private/zhixing-v2-data
# SQLITE_WAL=true

# DeepSeek is used for RAG answers, topic extraction, question generation, and answer feedback.
DEEPSEEK_API_KEY=
DEEPSEEK_RAG_TIMEOUT=60
DEEPSEEK_QUESTION_TIMEOUT=60
DEEPSEEK_FEEDBACK_TIMEOUT=15
DEEPSEEK_TOPIC_TIMEOUT=60
DEEPSEEK_COACH_TIMEOUT=20
DEEPSEEK_COACH_MODEL=deepseek-chat

# Alibaba Cloud Model Studio (Bailian) is used for document embeddings.
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_TIMEOUT=30
DASHSCOPE_EMBEDDING_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Optional. These defaults are used when omitted.
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024

# RAG: recall at least 10 candidates, rerank, then send the best 3 to the LLM.
RAG_RERANK_ENABLED=false
# RAG-only retrieval: vector (default), hybrid (vector + BM25 + RRF), or bm25.
RAG_RETRIEVAL_METHOD=vector
RAG_RRF_K=60
DASHSCOPE_RERANK_MODEL=qwen3-rerank
DASHSCOPE_RERANK_TIMEOUT=15
# Optional: derived from the Embedding workspace host if omitted.
# Uses /compatible-api/, NOT the Embedding /compatible-mode/ path.
# DASHSCOPE_RERANK_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
# Optional: defaults to the existing DASHSCOPE_API_KEY.
# DASHSCOPE_RERANK_API_KEY=
